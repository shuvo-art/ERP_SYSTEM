{
    "IpRateLimiting": {
        "EnableEndpointRateLimiting": true,
        "StackBlockedRequests": false,
        "RealIpHeader": "X-Real-IP",
        "ClientIdHeader": "X-ClientId",
        "HttpStatusCode": 429,
        "GeneralRules": [
            {
                "Endpoint": "POST:/api/v1/auth/login",
                "Period": "15m",
                "Limit": 30
            },
            {
                "Endpoint": "POST:/api/v1/auth/register",
                "Period": "1h",
                "Limit": 5
            },
            {
                "Endpoint": "POST:/api/v1/auth/verify-email",
                "Period": "15m",
                "Limit": 20
            },
            {
                "Endpoint": "POST:/api/v1/auth/resend-otp",
                "Period": "1h",
                "Limit": 5
            },
            {
                "Endpoint": "POST:/api/v1/auth/forgot-password",
                "Period": "1h",
                "Limit": 5
            },
            {
                "Endpoint": "POST:/api/v1/auth/reset-password",
                "Period": "15m",
                "Limit": 10
            },
            {
                "Endpoint": "POST:/api/v1/auth/refresh-token",
                "Period": "15m",
                "Limit": 50
            },
            {
                "Endpoint": "*:/api/v1/auth/logout",
                "Period": "1m",
                "Limit": 10
            },
            {
                "Endpoint": "GET:/api/v1/auth/me",
                "Period": "1m",
                "Limit": 60
            },
            {
                "Endpoint": "GET:/api/v1/users/profile",
                "Period": "1m",
                "Limit": 60
            },
            {
                "Endpoint": "PUT:/api/v1/users/profile",
                "Period": "1m",
                "Limit": 10
            },
            {
                "Endpoint": "PUT:/api/v1/users/change-password",
                "Period": "15m",
                "Limit": 5
            },
            {
                "Endpoint": "POST:/api/v1/users/fcm-token",
                "Period": "1m",
                "Limit": 10
            },
            {
                "Endpoint": "GET:/api/v1/users/all",
                "Period": "1m",
                "Limit": 30
            },
            {
                "Endpoint": "GET:/api/v1/users/statistics",
                "Period": "1m",
                "Limit": 20
            },
            {
                "Endpoint": "PUT:/api/v1/users/*/role",
                "Period": "1m",
                "Limit": 20
            },
            {
                "Endpoint": "DELETE:/api/v1/users/*",
                "Period": "1m",
                "Limit": 10
            },
            {
                "Endpoint": "*",
                "Period": "1m",
                "Limit": 100
            }
        ]
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "ConnectionStrings": {
        "DefaultConnection": "Server=sqlserver;Database=ErpDb;User Id=sa;Password=YourStrong@Passw0rd;TrustServerCertificate=True;",
        "Redis": "localhost:6379"
    },
    "RedisSettings": {
        "InstanceName": "AuthApi"
    },
    "JwtSettings": {
        "SecretKey": "your-super-secret-key-minimum-32-characters-long-change-in-production",
        "Issuer": "AuthApi",
        "Audience": "ErpClients",
        "AccessTokenExpirationMinutes": "15",
        "RefreshTokenExpirationDays": "7"
    },
    "EmailSettings": {
        "SmtpHost": "smtp.gmail.com",
        "SmtpPort": "587",
        "SmtpUser": "YOUR_GMAIL_ADDRESS@gmail.com",
        "SmtpPass": "YOUR_APP_PASSWORD",
        "FromEmail": "noreply@authapi.com",
        "FromName": "Auth API",
        "EnableSsl": "true"
    }
}